# Copy to .env.local and fill in. Mirror the same values in Vercel
# (Settings → Environment Variables) for Production, Preview, and Development.

# ---- Supabase ----------------------------------------------------------------

# From Project Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (Calendar API) --------------------------------------------
#
# Set up in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web application). Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-domain>/api/auth/google/callback

# Client ID is technically not secret, but we keep it server-only since we
# never use it in the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. If not set, the wiki derives the redirect from the incoming
# request origin. Set this if your deploy lives behind a proxy or you want to
# pin a specific URL.
# GOOGLE_OAUTH_REDIRECT_URI=
