# Copy to .env.local and fill in values from your Supabase project
# (Project Settings → API).
#
# Same three vars must also be set in the Vercel project (Settings → Environment Variables)
# for Production, Preview, and Development.

# Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=
