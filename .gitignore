# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright MCP per-session debug artifacts (snapshots, console logs, screenshots)
/.playwright-mcp/
/page-*.png
/page-*.jpeg
/file-preview.png
/phase*.png
/edit-bug-*.png
/walkthrough-*.png
/debug-*.png
/required-fields.png
